--// RE-EXECUTION CLEANUP
local env = getgenv and getgenv() or _G
local coreKey = "PurpleCFrameSpeedCore"

if env[coreKey] and env[coreKey].Unload then
    env[coreKey].Unload()
end

local oldGui = playerGui:FindFirstChild("PurpleCFrameSpeed")
if oldGui then
    oldGui:Destroy()
end

--// CORE
local Core = {
    Speed = 1,
    MinSpeed = 0,
    MaxSpeed = 100,
    Connections = {},
    Running = true,
    GUI = nil,
    Minimized = false
}

env[coreKey] = Core

function Core.Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Core.Connections, connection)
    return connection
end

function Core.Unload()
    if not Core.Running then return end

    Core.Running = false

    for _, connection in ipairs(Core.Connections) do
        connection:Disconnect()
    end

    table.clear(Core.Connections)

    if Core.GUI then
        Core.GUI:Destroy()
        Core.GUI = nil
    end

    if env[coreKey] == Core then
        env[coreKey] = nil
    end
end

