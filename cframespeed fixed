local reset = button("RESET", UDim2.fromOffset(92, 163), UDim2.fromOffset(116, 35), content)
local plus = button("+", UDim2.fromOffset(215, 163), UDim2.fromOffset(55, 35), content)

local function setSpeed(value)
    value = tonumber(value)
    if not value or value ~= value then return end
    value = math.clamp(math.round(value), 0, 100)
    core.Speed = value
    speedBox.Text = tostring(value)
    info.Text = "Speed: " .. value
    local fraction = value / 100
    fill.Size = UDim2.fromScale(fraction, 1)
    knob.Position = UDim2.fromScale(fraction, 0.5)
    for i, b in ipairs(presetButtons) do
        b.BackgroundColor3 = (presets[i] == value) and colors.accent or colors.panel
    end
end

for i, b in ipairs(presetButtons) do
    local preset = presets[i]
    connect(b.MouseButton1Click, function()
        setSpeed(preset)
    end)
end
-- Tap once for one step; hold for 0.4 seconds to repeat slowly.
local function holdSpeedButton(btn, step)
    local heldInput = nil
    local holding = false
    local sequence = 0

    connect(btn.InputBegan, function(input)
        local kind = input.UserInputType
        if holding or (kind ~= Enum.UserInputType.MouseButton1
            and kind ~= Enum.UserInputType.Touch) then return end

        holding = true
        heldInput = input
        sequence = sequence + 1
        local mySequence = sequence
        setSpeed(core.Speed + step)

        task.spawn(function()
            task.wait(0.4)
            while core.Running and holding and sequence == mySequence do
                setSpeed(core.Speed + step)
                task.wait(0.13)
            end
        end)
    end)

    connect(UIS.InputEnded, function(input)
        if holding and input == heldInput then
            holding = false
            heldInput = nil
            sequence = sequence + 1
        end
    end)
end

holdSpeedButton(minus, -1)
holdSpeedButton(plus, 1)
connect(reset.MouseButton1Click, function() setSpeed(1) end)
connect(speedBox.FocusLost, function()
    setSpeed(tonumber(speedBox.Text) or core.Speed)
end)

-- Slider and window have independent drag state.
local sliderMouse = false
local sliderTouch = nil
local function updateSlider(input)
    local width = track.AbsoluteSize.X
    if width <= 0 then return end
    local fraction = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
    setSpeed(fraction * 100)
end
local function startSlider(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderMouse = true
        updateSlider(input)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        sliderTouch = input
        updateSlider(input)
    end
end
connect(track.InputBegan, startSlider)
connect(knob.InputBegan, startSlider)
connect(UIS.InputChanged, function(input)
    if (sliderMouse and input.UserInputType == Enum.UserInputType.MouseMovement)
        or (sliderTouch and input == sliderTouch) then
        updateSlider(input)
    end
end)
connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then sliderMouse = false end
    if input == sliderTouch then sliderTouch = nil end
end)

local guiMouse = false
local guiTouch = nil
local dragStart
local frameStart
connect(topBar.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        guiMouse = true
    elseif input.UserInputType == Enum.UserInputType.Touch then
        guiTouch = input
    else
        return
    end
    dragStart = input.Position
    frameStart = frame.Position
end)
connect(UIS.InputChanged, function(input)
    if not ((guiMouse and input.UserInputType == Enum.UserInputType.MouseMovement)
        or (guiTouch and input == guiTouch)) then return end
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        frameStart.X.Scale, frameStart.X.Offset + delta.X,
        frameStart.Y.Scale, frameStart.Y.Offset + delta.Y
    )
end)
connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then guiMouse = false end
    if input == guiTouch then guiTouch = nil end
end)

local minimized = false
connect(minimize.MouseButton1Click, function()
    minimized = not minimized
    content.Visible = not minimized
    frame.Size = UDim2.fromOffset(300, minimized and 42 or 268)
    minimize.Text = minimized and "+" or "−"
end)

-- Apply extra movement while walking.
connect(RunService.Heartbeat, function(dt)
    if not core.Running or core.Speed <= 0 then return end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if humanoid and root and humanoid.Health > 0 then
        local direction = humanoid.MoveDirection
        if direction.Magnitude > 0 then
            root.CFrame = root.CFrame + direction * core.Speed * dt * 10
        end
    end
end)

setSpeed(1)
