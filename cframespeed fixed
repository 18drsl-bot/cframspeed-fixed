--// SPEED FUNCTION
local function setSpeed(value)
    value = tonumber(value)
    if not value then return end

    value = math.clamp(
        math.round(value),
        Core.MinSpeed,
        Core.MaxSpeed
    )

    Core.Speed = value

    speedBox.Text = tostring(value)
    info.Text = "Speed: " .. tostring(value)

    local percent = value / Core.MaxSpeed

    sliderFill.Size = UDim2.fromScale(percent, 1)
    knob.Position = UDim2.fromScale(percent, 0.5)
end

--// TEXTBOX
Core.Connect(speedBox.FocusLost, function()
    setSpeed(tonumber(speedBox.Text) or Core.Speed)
end)

--// BUTTONS
Core.Connect(minus.MouseButton1Click, function()
    setSpeed(Core.Speed - 1)
end)

Core.Connect(plus.MouseButton1Click, function()
    setSpeed(Core.Speed + 1)
end)

Core.Connect(reset.MouseButton1Click, function()
    setSpeed(1)
end)

--// SLIDER DRAGGING
local sliderDragging = false
local sliderTouch = nil

local function updateSlider(input)
    local x = input.Position.X
    local startX = slider.AbsolutePosition.X
    local width = slider.AbsoluteSize.X

    if width <= 0 then return end

    local percent = math.clamp(
        (x - startX) / width,
        0,
        1
    )

    setSpeed(percent * Core.MaxSpeed)
end

local function startSlider(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
        sliderTouch = nil
        updateSlider(input)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        sliderTouch = input
        updateSlider(input)
    end
end

Core.Connect(knob.InputBegan, startSlider)
Core.Connect(slider.InputBegan, startSlider)

Core.Connect(UIS.InputChanged, function(input)
    if not sliderDragging then return end

    if sliderTouch then
        if input == sliderTouch then
            updateSlider(input)
        end
    elseif input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input)
    end
end)

Core.Connect(UIS.InputEnded, function(input)
    if sliderTouch then
        if input == sliderTouch then
            sliderDragging = false
            sliderTouch = nil
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = false
    end
end)

--// TOP BAR ONLY GUI DRAGGING
local guiDragging = false
local guiTouch = nil
local dragStart
local startPosition

Core.Connect(topBar.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        guiDragging = true
        dragStart = input.Position
        startPosition = frame.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            guiTouch = input
        else
            guiTouch = nil
        end
    end
end)

Core.Connect(UIS.InputChanged, function(input)
    if not guiDragging then return end

    local validInput = false

    if guiTouch then
        validInput = input == guiTouch
    else
        validInput =
            input.UserInputType == Enum.UserInputType.MouseMovement
    end

    if validInput then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

Core.Connect(UIS.InputEnded, function(input)
    if guiTouch then
        if input == guiTouch then
            guiDragging = false
            guiTouch = nil
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        guiDragging = false
    end
end)

--// MINIMIZE / RESTORE
Core.Connect(minimize.MouseButton1Click, function()
    Core.Minimized = not Core.Minimized

    if Core.Minimized then
        content.Visible = false
        frame.Size = UDim2.fromOffset(300, 42)
        minimize.Text = "+"
    else
        frame.Size = UDim2.fromOffset(300, 245)
        content.Visible = true
        minimize.Text = "-"
    end
end)

--// CFRAME SPEED MOVEMENT
Core.Connect(RunService.Heartbeat, function(dt)
    if not Core.Running then return end

    local character = player.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if humanoid and root and humanoid.Health > 0 then
        local direction = humanoid.MoveDirection

        if direction.Magnitude > 0 then
            root.CFrame = root.CFrame
                + direction * Core.Speed * dt * 10
        end
    end
end)

