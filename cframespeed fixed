-- Instant speed presets: 5, 10, 15, 20.
local presets = {5, 10, 15, 20}
local presetButtons = {}
for i, value in ipairs(presets) do
    local b = button(tostring(value), UDim2.fromOffset(30 + (i - 1) * 61, 118), UDim2.fromOffset(55, 36), content)
    presetButtons[i] = b
