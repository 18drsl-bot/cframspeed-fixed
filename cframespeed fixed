local P = game:GetService("Players").LocalPlayer
local C = P.Character or P.CharacterAdded:Wait()
local H = C:WaitForChild("HumanoidRootPart")
local R = game:GetService("RunService")
local U = game:GetService("UserInputService")

-- mount helper (gethui -> CoreGui -> PlayerGui)
local function mount(screenGui)
    local ok = pcall(function()
        if typeof(gethui) == "function" then
            screenGui.Parent = gethui()
        else
            screenGui.Parent = game:GetService("CoreGui")
        end
    end)
    if not ok or not screenGui.Parent then
        screenGui.Parent = P:WaitForChild("PlayerGui")
    end
end

_G.CFrameSpeed = _G.CFrameSpeed or 6   -- studs/sec (6 = old .09 feel at 60fps)

-- create GUI, then mount it
local G = P.PlayerGui:FindFirstChild("SpeedControlGui") or Instance.new("ScreenGui")
G.Name = "SpeedControlGui"
G.ResetOnSpawn = false
if not G.Parent then mount(G) end

local F = G:FindFirstChild("Container") or Instance.new("Frame", G)
F.Name = "Container"
F.Size = UDim2.new(0, 220, 0, 70)
F.Position = UDim2.new(0, 12, 0, 12)
F.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
F.BackgroundTransparency = .25
F.BorderSizePixel = 0

local function mk(t, p, n, x)
    local o = p:FindFirstChild(n) or Instance.new(t, p)
    o.Name = n
    for k, v in pairs(x) do o[k] = v end
    return o
end

local T = mk("TextLabel", F, "Title", {
    Size = UDim2.new(1, -12, 0, 20), Position = UDim2.new(0, 6, 0, 6),
    BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.SourceSansBold, TextSize = 14, Text = "CFrame Speed",
    TextXAlignment = Enum.TextXAlignment.Left
})

local V = mk("TextLabel", F, "ValueLabel", {
    Size = UDim2.new(1, -12, 0, 18), Position = UDim2.new(0, 6, 0, 26),
    BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(200, 200, 200),
    Font = Enum.Font.SourceSans, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left
})

local B = mk("TextBox", F, "SpeedBox", {
    Size = UDim2.new(0, 80, 0, 24), Position = UDim2.new(1, -86, 0, 22),
    BackgroundTransparency = .9, TextColor3 = Color3.new(0, 0, 0),
    Font = Enum.Font.SourceSans, TextSize = 14,
    PlaceholderText = "speed", ClearTextOnFocus = false
})

local function up()
    V.Text = "Current: " .. _G.CFrameSpeed .. " studs/s"
    if not B:IsFocused() then B.Text = tostring(_G.CFrameSpeed) end
end
up()

B.FocusLost:Connect(function()
    local n = tonumber(B.Text)
    if n then _G.CFrameSpeed = math.clamp(n, 0, 1e15) end
    up()
end)

local K = { W = false, A = false, S = false, D = false }
U.InputBegan:Connect(function(i, g)
    if not g and K[i.KeyCode.Name] ~= nil then K[i.KeyCode.Name] = true end
end)
U.InputEnded:Connect(function(i)
    if K[i.KeyCode.Name] ~= nil then K[i.KeyCode.Name] = false end
end)

P.CharacterAdded:Connect(function(c)
    C = c
    H = c:WaitForChild("HumanoidRootPart")
    for k in pairs(K) do K[k] = false end
    up()
end)

-- ===== movement =====
local vel = Vector3.zero
local ACCEL = 20        -- higher = snappier
local USE_COLLISION = false  -- set true to stop at walls

R.RenderStepped:Connect(function(dt)
    if not H or not H.Parent then
        C = P.Character or P.CharacterAdded:Wait()
        H = C:WaitForChild("HumanoidRootPart")
    end

    local cam = workspace.CurrentCamera
    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector

    -- flatten to horizontal plane; guard NaN when looking straight up/down
    local f = Vector3.new(look.X, 0, look.Z)
    local r = Vector3.new(right.X, 0, right.Z)
    if f.Magnitude < 1e-4 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    if r.Magnitude < 1e-4 then r = Vector3.new(1, 0, 0)  else r = r.Unit end

    local dir = Vector3.zero
    if K.W then dir += f end
    if K.S then dir -= f end
    if K.A then dir -= r end
    if K.D then dir += r end
    if dir.Magnitude > 0 then dir = dir.Unit end

    local targetVel = dir * (_G.CFrameSpeed or 0)
    vel = vel:Lerp(targetVel, math.clamp(ACCEL * dt, 0, 1))

    if dir.Magnitude == 0 and vel.Magnitude < .01 then
        vel = Vector3.zero
    end

    if vel.Magnitude > 0 then
        local move = vel * dt
        if USE_COLLISION then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {C}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local hit = workspace:Raycast(H.Position, move, params)
            if hit then
                H.CFrame += move.Unit * math.max(hit.Distance - 0.2, 0)
            else
                H.CFrame += move
            end
        else
            H.CFrame += move
        end
    end
end)
-- ===== end movement =====

-- dragging
do
    local d, s, p
    T.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            d = true; s = i.Position; p = F.Position
        end
    end)
    U.InputChanged:Connect(function(i)
        if d and i.UserInputType == Enum.UserInputType.MouseMovement then
            local o = i.Position - s
            F.Position = UDim2.new(0, p.X.Offset + o.X, 0, p.Y.Offset + o.Y)
        end
    end)
    U.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end
    end)
end
