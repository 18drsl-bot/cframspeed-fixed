local key = "PurpleCFrameSpeedCore"

if env[key] and type(env[key].Unload) == "function" then
    env[key].Unload()
end
local old = playerGui:FindFirstChild("PurpleCFrameSpeed")
if old then old:Destroy() end

local core = {Speed = 1, Connections = {}, Running = true}
env[key] = core

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(core.Connections, connection)
    return connection
end

function core.Unload()
    if not core.Running then return end
    core.Running = false
    for _, connection in ipairs(core.Connections) do
        connection:Disconnect()
    end
    if core.GUI then core.GUI:Destroy() end
    if env[key] == core then env[key] = nil end
end

