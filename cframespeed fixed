
--// PURPLE CFRAME SPEED UI
--// MAIN CORE - RE-EXECUTION SAFE
--// LocalScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// UNLOAD PREVIOUS EXECUTION
local env = getgenv and getgenv() or _G
local coreKey = "PurpleCFrameSpeedCore"

if env[coreKey] then
    local oldCore = env[coreKey]

    if oldCore.Unload then
        oldCore.Unload()
    end
end

--// CLEAN UP ANY OLD GUI
local oldGui = playerGui:FindFirstChild("PurpleCFrameSpeed")

if oldGui then
    oldGui:Destroy()
end

--// MAIN CORE
local Core = {
    Speed = 1,
    Connections = {},
    Running = true,
    GUI = nil
}

env[coreKey] = Core

--// CONNECTION MANAGER
function Core.Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Core.Connections, connection)
    return connection
end

--// UNLOAD FUNCTION
function Core.Unload()
    if not Core.Running then
        return
    end

    Core.Running = false

    for _, connection in ipairs(Core.Connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    table.clear(Core.Connections)

    if Core.GUI then
        Core.GUI:Destroy()
        Core.GUI = nil
    end

    if env[coreKey] == Core then
        env[coreKey] = nil
    end
end

--// CREATE GUI
local gui = Instance.new("ScreenGui")
gui.Name = "PurpleCFrameSpeed"
gui.ResetOnSpawn = false
gui.Parent = playerGui

Core.GUI = gui

--// MAIN FRAME
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 150)
frame.Position = UDim2.new(0.5, -140, 0.5, -75)
frame.BackgroundColor3 = Color3.fromRGB(35, 20, 55)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(170, 75, 255)
stroke.Thickness = 2
stroke.Parent = frame

--// TITLE
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = "CFRAME SPEED"
title.TextColor3 = Color3.fromRGB(200, 130, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.Parent = frame

--// SPEED INPUT
local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0, 220, 0, 42)
speedBox.Position = UDim2.new(0.5, -110, 0, 65)
speedBox.BackgroundColor3 = Color3.fromRGB(65, 35, 95)
speedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
speedBox.PlaceholderText = "Enter CFrame Speed"
speedBox.Text = "1"
speedBox.Font = Enum.Font.GothamBold
speedBox.TextSize = 17
speedBox.ClearTextOnFocus = false
speedBox.Parent = frame

local boxCorner = Instance.new("UICorner")
boxCorner.CornerRadius = UDim.new(0, 8)
boxCorner.Parent = speedBox

--// SPEED INFO
local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, 0, 0, 25)
info.Position = UDim2.new(0, 0, 0, 115)
info.BackgroundTransparency = 1
info.Text = "Current Speed: 1"
info.TextColor3 = Color3.fromRGB(180, 130, 255)
info.Font = Enum.Font.Gotham
info.TextSize = 13
info.Parent = frame

--// UPDATE SPEED
Core.Connect(speedBox.FocusLost, function()
    if not Core.Running then return end

    local newSpeed = tonumber(speedBox.Text)

    if newSpeed and newSpeed >= 0 and newSpeed <= 100 then
        Core.Speed = newSpeed
    end

    speedBox.Text = tostring(Core.Speed)
    info.Text = "Current Speed: " .. tostring(Core.Speed)
end)

--// CFRAME SPEED MOVEMENT
Core.Connect(RunService.Heartbeat, function(dt)
    if not Core.Running then return end

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid and root and humanoid.Health > 0 then
        local direction = humanoid.MoveDirection

        if direction.Magnitude > 0 then
            root.CFrame = root.CFrame
                + direction * Core.Speed * dt * 10
        end
    end
end)
